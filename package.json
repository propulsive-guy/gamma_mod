{
  "name": "bitbyte",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:preview": "concurrently \"npm run dev:backend\" \"next dev client -p 5001\"",
    "dev:backend": "API_ONLY=true PORT=3001 tsx server/index.ts",
    "dev:frontend": "npm run dev --prefix client -- --webpack",
    "build:client": "npm run build --prefix client",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "API_ONLY=true PORT=3001 NODE_ENV=production node server/index.js",
    "start:frontend": "next start client -p 3000",
    "lint": "next lint client"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "clsx": "^2.1.1",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "ioredis": "^5.10.1",
    "mongoose": "^9.1.6",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-to-print": "^3.2.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
